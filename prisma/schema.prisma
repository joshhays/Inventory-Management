// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  name            String?
  phone           String?
  isAdmin         Boolean          @default(false)
  isUser          Boolean          @default(true)
  groups          UserGroupMember[]
  savedAddresses  SavedAddress[]
  dashboardWidgets DashboardWidget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model DashboardWidget {
  id             Int        @id @default(autoincrement())
  userId         Int
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploymentId   Int?       // null = legacy (show for all); set = deployment-specific
  title          String
  reportName     String     // e.g. getSalesByPeriod, getOrdersSummary
  reportParams   String     @default("{}") // JSON
  chartType      String     @default("bar") // bar, line, pie
  size           String     @default("medium") // small, medium, large
  sortOrder      Int        @default(0)
  posX           Int        @default(0) // free-form board position
  posY           Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model SavedAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // e.g. "Home", "Office"
  name      String
  company   String?
  address1  String
  address2  String?
  city      String
  state     String
  zip       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserGroupMember {
  userId Int
  groupId Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group  UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([userId, groupId])
}

model Deployment {
  id           Int         @id @default(autoincrement())
  name         String      // e.g. "Acme Corp"
  slug         String      @unique // e.g. "acme"
  logoUrl      String?
  brandColor1  String?     // PMS color 1 (hex) - header
  brandColor2  String?     // PMS color 2 (hex) - background gradient
  customerInfo String?     // JSON: { address?, phone?, email?, ... }
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]
  orders       Order[]
  groups       UserGroup[]
  categories   DeploymentCategory[]
  shippingTiers ShippingTier[]
  discountRules OrderDiscountRule[]
}

model ShippingTier {
  id            Int        @id @default(autoincrement())
  deploymentId  Int
  deployment    Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  minQuantity   Int        // Applies when item count >= this (e.g. 1, 251, 501)
  weightLbs     Float      // Total weight in lbs
  lengthInches  Float      // Box length
  widthInches   Float      // Box width
  heightInches  Float      // Box height
  name          String?    // Optional label, e.g. "250 cards"
  sortOrder     Int        @default(0) // Lower = higher priority when matching
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model DeploymentCategory {
  id           Int        @id @default(autoincrement())
  deploymentId Int
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name         String     // e.g. "Stationery", "Office Supplies"
  sortOrder    Int        @default(0) // Lower = first on storefront
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([deploymentId, name])
}

model UserGroup {
  id           Int              @id @default(autoincrement())
  name         String
  deploymentId Int
  deployment   Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  products     Product[]
  members      UserGroupMember[]

  @@unique([name, deploymentId])
}

model Product {
  id                  Int          @id @default(autoincrement())
  deploymentId        Int
  deployment          Deployment   @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name                String
  sku                 String
  quantity            Int          @default(0)

  @@unique([deploymentId, sku])
  price               Float
  description         String?
  category            String?      // Store category tag (e.g. stationery)
  productType         String       @default("regular") // "regular" | "kit"
  groupId             Int?
  group               UserGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  isPrintOnDemand     Boolean      @default(false)
  printTemplateConfig String?      // JSON: { layout, fields: [{ key, label }] }
  allowedQuantities   String?      // JSON array e.g. [250,500,750] - restrict order qty to these values
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  files               ProductFile[]
  kitItems            KitItem[]    @relation("KitChildren")
  parentKits          KitItem[]    @relation("KitParent")
}

model KitItem {
  id           Int     @id @default(autoincrement())
  kitId        Int     // The kit product
  productId    Int     // The child product
  quantity     Int     @default(1) // How many of this product per kit
  kit          Product @relation("KitChildren", fields: [kitId], references: [id], onDelete: Cascade)
  product      Product @relation("KitParent", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitId, productId])
}

model ProductFile {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename  String
  path      String
  createdAt DateTime @default(now())
}

model InventoryLog {
  id             Int      @id @default(autoincrement())
  productId      Int?
  sku            String
  productName    String
  action         String
  quantityBefore Int
  quantityAfter  Int
  source         String   @default("manual")
  createdAt      DateTime @default(now())
}

model OrderDiscountRule {
  id                 Int        @id @default(autoincrement())
  deploymentId       Int
  deployment         Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name               String     // e.g. "Bulk discount (2+ products)"
  type               String     // "percent" | "fixed"
  value              Float      // percent 0-100 or dollar amount
  minDistinctProducts Int       @default(0) // e.g. 2 = need 2 different products
  minQuantity        Int       @default(0)  // min total item count
  minSubtotal        Float     @default(0)   // min subtotal in dollars
  sortOrder          Int       @default(0)  // higher = higher priority
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Order {
  id                  Int         @id @default(autoincrement())
  deploymentId        Int
  deployment          Deployment  @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  customerName        String
  customerEmail       String
  customerPhone       String?
  shippingAddress     String?
  shippingCost        Float        @default(0)
  shippingMethod      String?
  discountAmount      Float        @default(0)
  shippingLabelUrl    String?      // URL to shipping label (EasyPost, etc.)
  trackingCode        String?      // Carrier tracking number
  easypostShipmentId  String?      // EasyPost shipment ID for label creation
  status              String      @default("pending")
  total               Float
  pickingStartedAt    DateTime?
  pickingCompletedAt  DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  sku         String
  productName String
  quantity    Int
  unitPrice   Float
  lineTotal   Float
  picked      Boolean @default(false)
  printData   String? // JSON: customer-provided data for print-on-demand (e.g. name, title for business card)
  printPdfPath String? // Relative path under /uploads where the approved POD PDF is stored
}
