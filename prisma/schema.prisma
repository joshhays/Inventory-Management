// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int              @id @default(autoincrement())
  email     String           @unique
  password  String
  name      String?
  isAdmin   Boolean          @default(false)
  isUser    Boolean          @default(true)
  groups    UserGroupMember[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model UserGroupMember {
  userId Int
  groupId Int
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group  UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([userId, groupId])
}

model UserGroup {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  products Product[]
  members  UserGroupMember[]
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  sku         String       @unique
  quantity    Int          @default(0)
  price       Float
  description String?
  category    String?      // Store category tag (e.g. stationery)
  productType String       @default("regular") // "regular" | "kit"
  groupId     Int?
  group       UserGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  files       ProductFile[]
  kitItems    KitItem[]    @relation("KitChildren")
  parentKits  KitItem[]    @relation("KitParent")
}

model KitItem {
  id           Int     @id @default(autoincrement())
  kitId        Int     // The kit product
  productId    Int     // The child product
  quantity     Int     @default(1) // How many of this product per kit
  kit          Product @relation("KitChildren", fields: [kitId], references: [id], onDelete: Cascade)
  product      Product @relation("KitParent", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitId, productId])
}

model ProductFile {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename  String
  path      String
  createdAt DateTime @default(now())
}

model InventoryLog {
  id             Int      @id @default(autoincrement())
  productId      Int?
  sku            String
  productName    String
  action         String
  quantityBefore Int
  quantityAfter  Int
  source         String   @default("manual")
  createdAt      DateTime @default(now())
}

model Order {
  id              Int         @id @default(autoincrement())
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String?
  status          String      @default("pending")
  total           Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  sku         String
  productName String
  quantity    Int
  unitPrice   Float
  lineTotal   Float
}
