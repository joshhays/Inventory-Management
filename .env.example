# Local development:
DATABASE_URL="file:./dev.db"
PORT=3000

# Required for session-based auth. Use a long random string in production.
SESSION_SECRET="change-me-in-production"

# Optional: creates/updates admin user on server startup (useful for Railway)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="your-password"

# Railway (set in Railway dashboard - volume mounts at /data):
# DATABASE_URL="file:/data/dev.db"

# AI Reports (optional) - enables ChatGPT-style report generation
# Get key from https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"  # or gpt-4o for better quality
