# Local development:
DATABASE_URL="file:./dev.db"
PORT=3000

# Required for session-based auth. Use a long random string in production.
SESSION_SECRET="change-me-in-production"

# Optional: creates/updates admin user on server startup (useful for Railway)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="your-password"

# Railway (set in Railway dashboard - volume mounts at /data):
# DATABASE_URL="file:/data/dev.db"

# Email (SMTP) - send "order ready" notification when status becomes "ready"
# IMAP is for receiving; SMTP is for sending. You need SMTP credentials.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="your-email@gmail.com"
# EMAIL_READY_TO="messenger-pickup@example.com"
