# Local development:
PORT=3000

# Database - PostgreSQL (Railway provides this when you add Postgres)
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Required for session-based auth. Use a long random string in production.
SESSION_SECRET="change-me-in-production"

# Optional: creates/updates admin user on server startup (useful for Railway)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="your-password"

# AI Reports (optional) - enables ChatGPT-style report generation
# Get key from https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"  # or gpt-4o for better quality

# Wasabi (S3-compatible) - presigned URLs for private bucket
# Get credentials from Wasabi console, create IAM user
# WASABI_ACCESS_KEY_ID=
# WASABI_SECRET_ACCESS_KEY=
# WASABI_BUCKET=your-bucket
# WASABI_REGION=us-east-1
# WASABI_ENDPOINT=https://s3.wasabisys.com

# Product files & logos: S3 keys must match stored path (e.g. product-1/xxx.jpg, deployment-logos/logo.png)

# EasyPost Shipping - labels and rates
# Get API key from https://www.easypost.com
# EASYPOST_API_KEY="EZPK..."
# EASYPOST_ORIGIN_NAME="Your Company"
# EASYPOST_ORIGIN_STREET1="123 Warehouse St"
# EASYPOST_ORIGIN_CITY="Chicago"
# EASYPOST_ORIGIN_STATE="IL"
# EASYPOST_ORIGIN_ZIP="60601"
# EASYPOST_ORIGIN_COUNTRY="US"
# EASYPOST_PARCEL_LENGTH=8
# EASYPOST_PARCEL_WIDTH=5
# EASYPOST_PARCEL_HEIGHT=5
# EASYPOST_PARCEL_WEIGHT=1
